{
  "name": "gezegeni-savun-ios",
  "version": "1.2.0",
  "description": "Gezegeni Koru \u2014 iOS/TestFlight with AdMob and Apple VIP StoreKit",
  "private": true,
  "scripts": {
    "ios:init": "npx cap add ios",
    "ios:sync": "npx cap sync ios",
    "ios:open": "npx cap open ios",
    "build:web": "node build-assets.cjs && node build-monetization.cjs && node scripts/verify-release.cjs",
    "test": "node --test tests/*.test.cjs",
    "capacitor:sync:before": "node ios_config/prepare-native.cjs",
    "postinstall": "node ios_config/patch-admob.cjs",
    "verify:native": "node scripts/verify-release.cjs ios/App/App/public"
  },
  "dependencies": {
    "@capacitor-community/admob": "6.2.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/ios": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0",
    "@fontsource/inter": "5.2.5",
    "@fontsource/orbitron": "5.2.5",
    "capacitor-plugin-cdv-purchase": "13.17.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "3.4.17"
  }
}
